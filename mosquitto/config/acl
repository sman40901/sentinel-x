# Droits par compte MQTT (remplacer g0X par votre numéro de groupe partout)

# Boîtier ESP32 : envoie mesures/alertes/état, reçoit les commandes
user esp32
topic write sentinelx/g0X/telemetry
topic write sentinelx/g0X/alerts
topic write sentinelx/g0X/status
topic read  sentinelx/g0X/cmd

# Script IA (webcam) : envoie seulement des alertes
user ia
topic write sentinelx/g0X/alerts

# API : lit tout le projet, envoie les commandes
user api
topic read  sentinelx/g0X/#
topic write sentinelx/g0X/cmd

# Admin (tests, MQTT Explorer) : accès complet
user admin
topic readwrite #
