# Groupe de la table : remplacer G0X
GROUP_ID=G0X

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USERNAME=ia
MQTT_PASSWORD=CHANGE_ME

# TLS
MQTT_CA_CERT=certs/ca.crt
# VIDES volontairement : le broker n'exige pas de certificat client, et
# gen-certs.sh ne genere pas ia.crt/ia.key. Les remplir fait echouer tls_set()
# sur un fichier introuvable.
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TLS_VERIFY=true

# Topics
MQTT_TELEMETRY_TOPIC=sentinelx/{group}/telemetry
MQTT_ALERT_TOPIC=sentinelx/{group}/alerts

# Webcam
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.45

# Face recognition
FACE_TOLERANCE=0.48
FACE_CHECK_EVERY_N_FRAMES=3
INTRUSION_COOLDOWN_SECONDS=10

# Predictive model
PREDICTIVE_MIN_SAMPLES=60
PREDICTIVE_WINDOW=10
PREDICTIVE_COOLDOWN_SECONDS=15
ANOMALY_WARNING_THRESHOLD=0.65
ANOMALY_CRITICAL_THRESHOLD=0.82

# Risk fusion
FUSION_WINDOW_SECONDS=8
