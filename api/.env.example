# Environment: test or prod
ENVIRONMENT=test

# MQTT Broker Configuration
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=your_mqtt_password

# Enable/disable TLS (set to "false" for development without certificates)
MQTT_USE_TLS=false

# TLS Certificate Path (only used if MQTT_USE_TLS=true)
MQTT_CA_CERT=/certs/ca.crt

# Group ID for MQTT Topics
GROUP_ID=g01
