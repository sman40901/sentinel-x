# Secrets : jamais dans Git (exigé par le sujet)
.env
certs/*.key
certs/*.crt
!certs/.gitkeep
mosquitto/config/passwd
firmware/**/secrets.h
__pycache__/

# Empreinte du mot de passe HTTP : jamais dans le depot.
/nginx/htpasswd

# Numero de serie genere par openssl ca : artefact, pas une source.
certs/*.srl
