# Copier en .env et remplacer chaque valeur. Le fichier .env n'est JAMAIS commité.

# Base de données
DB_NAME=sentinelx
DB_USER=sentinelx
DB_PASSWORD=change-moi-db

# Comptes MQTT (un par appareil). Les cinq sont obligatoires :
# scripts/add-mqtt-users.sh echoue si l'un manque.
MQTT_ESP32_PASSWORD=change-moi-esp32
MQTT_IA_PASSWORD=change-moi-ia
MQTT_API_PASSWORD=change-moi-api
MQTT_DASHBOARD_PASSWORD=change-moi-dashboard
MQTT_ADMIN_PASSWORD=change-moi-admin

# Clé de l'API (en-tête X-API-Key pour POST /api/v1/alerts et /api/v1/cmd)
API_KEY=change-moi-api-key

# Camera USB a diffuser.
#
# Chemin /dev/v4l/by-id/... et PAS /dev/videoN : le numero change au
# rebranchement (la UGREEN est passee de video2 a video3), et le conteneur
# refuse alors de demarrer sur "no such file or directory". Le chemin by-id
# est lie au materiel et ne bouge pas.
#
# Pour trouver le votre :  ls -l /dev/v4l/by-id/
CAMERA_DEVICE=/dev/v4l/by-id/usb-VOTRE_CAMERA-video-index0

# Authentification HTTP du dashboard, du flux camera et de l'API.
# Laisse vide pour reutiliser MQTT_DASHBOARD_PASSWORD (un seul secret a retenir).
DASHBOARD_HTTP_USER=dashboard
DASHBOARD_HTTP_PASSWORD=
