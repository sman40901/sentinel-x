# Copier en .env et remplacer chaque valeur. Le fichier .env n'est JAMAIS commité.

# Base de données
DB_NAME=sentinelx
DB_USER=sentinelx
DB_PASSWORD=change-moi-db

# Comptes MQTT (un par appareil)
MQTT_ESP32_PASSWORD=change-moi-esp32
MQTT_IA_PASSWORD=change-moi-ia
MQTT_API_PASSWORD=change-moi-api
MQTT_ADMIN_PASSWORD=change-moi-admin

# Clé de l'API (en-tête X-API-Key pour POST /api/v1/alerts et /api/v1/cmd)
API_KEY=change-moi-api-key
